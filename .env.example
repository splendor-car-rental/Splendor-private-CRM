# GEMINI_API_KEY: Required only when a Gemini-powered API action is invoked.
# Never commit a real key. Configure it in the deployment environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical application URL used for self-referential links/callbacks.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: Server-side Firebase Admin credential JSON.
# The server must fail closed when it is absent or belongs to an unexpected project.
# Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# EXPECTED_FIREBASE_PROJECT_ID: Optional explicit project pin used by hardened
# Firebase Admin initialization. Production should point only at the approved project.
EXPECTED_FIREBASE_PROJECT_ID="splendor-private-crm"

# KYC_TOKEN_SECRET: Required to generate or verify public KYC intake links.
# There is deliberately no source-code fallback. Use a high-entropy secret and
# rotate it through the deployment secret manager when required.
KYC_TOKEN_SECRET="REPLACE_WITH_HIGH_ENTROPY_SECRET"

# --- WhatsApp Cloud API (Meta Business Platform) -------------------------
# Optional until configured; outbound sends remain fail-closed/not-configured.
WHATSAPP_ACCESS_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_GROUP_RECIPIENTS="971501234567,971509876543"
WHATSAPP_API_VERSION="v21.0"

# Webhook verification token used only for Meta's GET subscription handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="MY_WEBHOOK_VERIFY_TOKEN"

# Meta App Secret used to verify X-Hub-Signature-256 on POST deliveries.
# Without it, webhook POSTs must be rejected rather than accepted unsigned.
WHATSAPP_APP_SECRET="MY_WHATSAPP_APP_SECRET"
