# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: Required for the server to verify who is
# calling the /api/* endpoints (login sessions). Without this set, the
# server rejects all API requests rather than allowing them through
# unauthenticated.
#
# How to get it:
#   1. Firebase Console -> Project Settings (gear icon) -> Service Accounts
#   2. Click "Generate new private key" -> a JSON file downloads
#   3. Paste the ENTIRE contents of that JSON file as a single line here
#      (and as the same-named environment variable in your hosting
#      provider's dashboard, e.g. Vercel -> Project -> Settings ->
#      Environment Variables)
#
# Treat this value as a secret: it grants administrative access to your
# Firebase project. Never commit the real value to git.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# --- WhatsApp Cloud API (Meta Business Platform) -------------------------
# Optional: until these are set, the WhatsApp Control Center still works
# (toggles, recipients, custom reminders all save normally), it just
# doesn't actually dispatch anything -- every send is recorded as
# 'not_configured' instead of silently pretending to succeed.
WHATSAPP_ACCESS_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_GROUP_RECIPIENTS="971501234567,971509876543"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="MY_WEBHOOK_VERIFY_TOKEN"
WHATSAPP_APP_SECRET="MY_WHATSAPP_APP_SECRET"

# --- Etqan GPS / Fleet Tracking ------------------------------------------
# Server-side only. Never expose these values through VITE_* variables,
# Firestore vehicle documents, or browser code. The live-radar UI is
# intentionally fail-closed and shows no simulated coordinates when these
# are absent.
#
# Ask Etqan for the exact values/field names from their API documentation;
# do not guess them. At minimum we need the live-position endpoint and the
# provider's device id / latitude / longitude / timestamp fields.
ETQAN_API_BASE_URL="https://provider-api.example"
ETQAN_API_TOKEN="MY_READ_ONLY_ETQAN_API_TOKEN"
ETQAN_LIVE_POSITIONS_PATH="/provider/live-positions"
ETQAN_ACCOUNT_ID="OPTIONAL_ACCOUNT_OR_FLEET_ID"

# Authentication header/scheme. Defaults in code: Authorization + Bearer.
ETQAN_AUTH_HEADER="Authorization"
ETQAN_AUTH_SCHEME="Bearer"

# Dot-path mapping into Etqan's actual JSON response. ETQAN_FIELD_COLLECTION
# may be blank only when the top-level response itself is an array.
ETQAN_FIELD_COLLECTION="data.positions"
ETQAN_FIELD_DEVICE_ID="device.id"
ETQAN_FIELD_LATITUDE="position.latitude"
ETQAN_FIELD_LONGITUDE="position.longitude"
ETQAN_FIELD_TIMESTAMP="position.timestamp"

# Optional live fields -- leave unset if Etqan does not expose them.
ETQAN_FIELD_SPEED="position.speedKmh"
ETQAN_FIELD_HEADING="position.heading"
ETQAN_FIELD_IGNITION="telemetry.ignition"
ETQAN_FIELD_ODOMETER="telemetry.odometerKm"
ETQAN_FIELD_FUEL="telemetry.fuelPercent"
ETQAN_FIELD_ENGINE_STATUS="telemetry.engineStatus"
