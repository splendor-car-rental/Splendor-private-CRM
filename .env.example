# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_KEY: Required for the server to verify who is
# calling the /api/* endpoints (login sessions). Without this set, the
# server rejects all API requests rather than allowing them through
# unauthenticated.
#
# How to get it:
#   1. Firebase Console -> Project Settings (gear icon) -> Service Accounts
#   2. Click "Generate new private key" -> a JSON file downloads
#   3. Paste the ENTIRE contents of that JSON file as a single line here
#      (and as the same-named environment variable in your hosting
#      provider's dashboard, e.g. Vercel -> Project -> Settings ->
#      Environment Variables)
#
# Treat this value as a secret: it grants administrative access to your
# Firebase project. Never commit the real value to git.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# --- WhatsApp Cloud API (Meta Business Platform) -------------------------
# Optional: until these are set, the WhatsApp Control Center still works
# (toggles, recipients, custom reminders all save normally), it just
# doesn't actually dispatch anything -- every send is recorded as
# 'not_configured' instead of silently pretending to succeed.

# WHATSAPP_ACCESS_TOKEN: permanent/system-user access token for your
# WhatsApp Business app (Meta App Dashboard -> WhatsApp -> API Setup, or a
# System User token from Business Settings for production use).
WHATSAPP_ACCESS_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"

# WHATSAPP_PHONE_NUMBER_ID: the sending number's Phone Number ID (Meta App
# Dashboard -> WhatsApp -> API Setup -- NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"

# WHATSAPP_GROUP_RECIPIENTS: comma-separated phone numbers (E.164, no "+")
# standing in for "the general WhatsApp group" -- the Cloud API can only
# send to individual numbers, not post into a group chat.
WHATSAPP_GROUP_RECIPIENTS="971501234567,971509876543"

# WHATSAPP_API_VERSION: optional, defaults to v21.0 if unset.
WHATSAPP_API_VERSION="v21.0"

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: a secret string YOU choose, entered in the
# Meta App Dashboard's webhook subscription form (Callback URL:
# https://<your-domain>/api/whatsapp/webhook). Meta echoes it back on the
# one-time GET verification handshake -- this proves the subscription
# request came from someone who knows this secret, not just anyone who
# guesses your webhook URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="MY_WEBHOOK_VERIFY_TOKEN"

# WHATSAPP_APP_SECRET: your Meta App's "App Secret" (App Dashboard ->
# Settings -> Basic). REQUIRED for the webhook to accept any POST delivery
# -- every incoming message/status event is authenticated by recomputing
# the X-Hub-Signature-256 HMAC Meta signs it with, keyed by this value.
# Without this set, POST /api/whatsapp/webhook rejects every delivery with
# 403 rather than accepting unverified payloads from the public internet.
WHATSAPP_APP_SECRET="MY_WHATSAPP_APP_SECRET"
