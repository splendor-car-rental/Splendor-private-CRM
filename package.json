{
  "name": "splendor-private-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/copyApprovedForms.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/server/vercelAppHandler.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/api-handler.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js api-handler.cjs api-handler.cjs.map",
    "lint": "tsc --noEmit",
    "test": "firebase emulators:exec --project=demo-splendor-crm-rules-test --only firestore \"vitest run --testTimeout=15000\"",
    "dr:drill": "tsx scripts/drDrill.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.2.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^1.1.4",
    "puppeteer-core": "^25.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.12",
    "firebase-tools": "^15.28.2",
    "playwright": "^1.56.1",
    "supertest": "^7.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.8.3",
    "vitest": "^4.1.11",
    "xlsx": "^0.18.5"
  }
}
