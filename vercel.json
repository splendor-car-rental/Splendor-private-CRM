{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{api/api-handler.mjs,dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/whatsapp/webhook", "destination": "/api/whatsapp-webhook" },
    { "source": "/api/issued-documents/:archiveId/whatsapp", "destination": "/api/document-whatsapp?archiveId=:archiveId" },
    { "source": "/api/blocklist", "destination": "/api/blocklist-v2" },
    { "source": "/api/customers", "destination": "/api/customers-guard" },
    { "source": "/api/telematics/live", "destination": "/api/telematics-provider" },
    { "source": "/api/corporate-accounts/:accountId", "destination": "/api/corporate-accounts-safe?accountId=:accountId" },
    { "source": "/api/corporate-accounts", "destination": "/api/corporate-accounts-safe" },
    { "source": "/api/reservations/:reservationId/create-contract", "destination": "/api/reservation-contract?reservationId=:reservationId" },
    { "source": "/api/contracts/:contractId/review", "destination": "/api/contract-lifecycle?action=review&contractId=:contractId" },
    { "source": "/api/contracts/:contractId/approve", "destination": "/api/contract-lifecycle?action=approve&contractId=:contractId" },
    { "source": "/api/contracts/:contractId/sign", "destination": "/api/contract-lifecycle?action=sign&contractId=:contractId" },
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/notifications/run-checks",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
