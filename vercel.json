{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/whatsapp/webhook", "destination": "/api/whatsapp-webhook" },
    { "source": "/api/contracts/:contractId/extend", "destination": "/api/contract-extension-safe?contractId=:contractId" },
    { "source": "/api/fleet/:vehicleId", "destination": "/api/fleet-safe?vehicleId=:vehicleId" },
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/notifications/run-checks",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
