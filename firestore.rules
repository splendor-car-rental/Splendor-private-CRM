rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SPLENDOR PRIVATE CRM — server-authoritative Firestore boundary.
    // Critical business mutations are performed by the Express API through
    // Firebase Admin SDK. Admin SDK writes bypass these client rules.
    // Browser access is limited to authenticated, provisioned ACTIVE staff
    // reads and narrowly-scoped self-profile fields.

    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerRole() {
      return callerProfile().role;
    }

    function isStaff() {
      return hasProfile()
        && callerProfile().status == 'active'
        && callerRole() in ['ceo', 'admin', 'operations', 'sales', 'fleet', 'finance'];
    }

    function hasRole(roles) {
      return isStaff() && callerRole() in roles;
    }

    // Staff directory is readable by provisioned active staff. Users cannot
    // create, replace, delete, or change role/status through the client SDK.
    match /users/{uid} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow create: if false;
      allow delete: if false;
      allow update: if isStaff()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'nameAr', 'phone', 'avatar']);
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Client-readable operational data. All mutations go through the API.
    match /vehicles/{id} { allow read: if isStaff(); allow write: if false; }
    match /customers/{id} { allow read: if isStaff(); allow write: if false; }
    match /leads/{id} { allow read: if isStaff(); allow write: if false; }
    match /opportunities/{id} { allow read: if isStaff(); allow write: if false; }
    match /quotations/{id} { allow read: if isStaff(); allow write: if false; }
    match /reservations/{id} { allow read: if isStaff(); allow write: if false; }
    match /contracts/{id} { allow read: if isStaff(); allow write: if false; }
    match /charges/{id} { allow read: if isStaff(); allow write: if false; }
    match /deposits/{id} { allow read: if isStaff(); allow write: if false; }
    match /payments/{id} { allow read: if isStaff(); allow write: if false; }
    match /invoices/{id} { allow read: if isStaff(); allow write: if false; }
    match /bank_batches/{id} { allow read: if isStaff(); allow write: if false; }
    match /bank_transactions/{id} { allow read: if isStaff(); allow write: if false; }
    match /tasks/{id} { allow read: if isStaff(); allow write: if false; }
    match /communications/{id} { allow read: if isStaff(); allow write: if false; }
    match /documents/{id} { allow read: if isStaff(); allow write: if false; }
    match /custom_fields/{id} { allow read: if isStaff(); allow write: if false; }
    match /numbering_configs/{id} { allow read: if isStaff(); allow write: if false; }
    match /notifications/{id} { allow read: if isStaff(); allow write: if false; }
    match /notification_event_configs/{id} { allow read: if isStaff(); allow write: if false; }
    match /custom_reminders/{id} { allow read: if isStaff(); allow write: if false; }
    match /whatsapp_message_log/{id} { allow read: if isStaff(); allow write: if false; }
    match /customer_notification_configs/{id} { allow read: if isStaff(); allow write: if false; }
    match /settings/{id} { allow read: if isStaff(); allow write: if false; }
    match /toll_transactions/{id} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }
    match /toll_import_batches/{id} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // Tax Compliance collections remain server-authoritative. Explicit read
    // rules make the active-staff boundary testable; all browser writes are denied.
    match /tax_master_profiles/{id} { allow read: if isStaff(); allow write: if false; }
    match /tax_master_profile_versions/{id} { allow read: if isStaff(); allow write: if false; }
    match /tax_official_sources/{id} { allow read: if isStaff(); allow write: if false; }
    match /tax_rule_versions/{id} { allow read: if isStaff(); allow write: if false; }
    match /tax_periods/{id} { allow read: if isStaff(); allow write: if false; }
    match /tax_period_exceptions/{id} { allow read: if isStaff(); allow write: if false; }
    match /tax_reconciliation_snapshots/{id} { allow read: if isStaff(); allow write: if false; }
    // Internal serial-allocation state is never a browser concern.
    match /tax_reconciliation_states/{id} { allow read, write: if false; }
    match /tax_audit_events/{id} { allow read: if isStaff(); allow write: if false; }
    match /tax_professional_validators/{id} { allow read: if isStaff(); allow write: if false; }

    // Lease-to-Own is also server-authoritative. These collections are
    // explicitly readable for CRM screens but never writable from the browser.
    match /lto_applications/{id} { allow read: if isStaff(); allow write: if false; }
    match /lto_installments/{id} { allow read: if isStaff(); allow write: if false; }
    match /lto_settlement_requests/{id} { allow read: if isStaff(); allow write: if false; }

    // New collections default to DENY because there is intentionally no
    // recursive catch-all rule.
  }
}
