rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Splendor Private CRM Security Rules
    // All operations require authenticated Firebase users.

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /toll_transactions/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /toll_import_batches/{id} {
      allow read, write: if isSignedIn();
    }

    match /vehicles/{id} { allow read, write: if isSignedIn(); }
    match /customers/{id} { allow read, write: if isSignedIn(); }
    match /leads/{id} { allow read, write: if isSignedIn(); }
    match /opportunities/{id} { allow read, write: if isSignedIn(); }
    match /quotations/{id} { allow read, write: if isSignedIn(); }
    match /reservations/{id} { allow read, write: if isSignedIn(); }
    match /contracts/{id} { allow read, write: if isSignedIn(); }
    match /charges/{id} { allow read, write: if isSignedIn(); }
    match /deposits/{id} { allow read, write: if isSignedIn(); }
    match /payments/{id} { allow read, write: if isSignedIn(); }
    match /invoices/{id} { allow read, write: if isSignedIn(); }
    match /bank_batches/{id} { allow read, write: if isSignedIn(); }
    match /bank_transactions/{id} { allow read, write: if isSignedIn(); }
    match /tasks/{id} { allow read, write: if isSignedIn(); }
    match /communications/{id} { allow read, write: if isSignedIn(); }
    match /documents/{id} { allow read, write: if isSignedIn(); }
    match /custom_fields/{id} { allow read, write: if isSignedIn(); }
    match /numbering_configs/{id} { allow read, write: if isSignedIn(); }
    match /notifications/{id} { allow read, write: if isSignedIn(); }
    match /notification_event_configs/{id} { allow read, write: if isSignedIn(); }
    match /custom_reminders/{id} { allow read, write: if isSignedIn(); }
    match /whatsapp_message_log/{id} { allow read, write: if isSignedIn(); }
    match /customer_notification_configs/{id} { allow read, write: if isSignedIn(); }
    match /settings/{id} { allow read, write: if isSignedIn(); }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}

